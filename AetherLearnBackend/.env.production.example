APP_NAME=AetherLearn
APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=info

SERVICE_HOST=0.0.0.0

MONGODB_URI=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# Generate all three with at least 32 random bytes.
# Example: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=replace-with-48-byte-random-secret
JWT_ACCESS_SECRET=replace-with-48-byte-random-secret
JWT_REFRESH_SECRET=replace-with-48-byte-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AUTH_DEMO_MODE=false
SEED_DEMO_DATA=false

OBJECT_STORAGE_DRIVER=minio
LOCAL_STORAGE_DIR=.data/storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET=aetherlearn
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Use gemini for hosted production AI, local-hub/ollama for private school hub deployments,
# or auto with fallback only when you intentionally permit mock fallback.
AI_RUNTIME=ollama
USE_MOCK=false
ALLOW_RUNTIME_FALLBACK=false
GEMINI_API_KEY=replace-with-server-side-api-key
GEMINI_MODEL=gemma-4-26b-a4b-it

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
ENFORCE_GEMMA_MODEL=true
REQUIRED_GEMMA_MODEL=gemma4:e4b

SCHOOL_HUB_MODE=false
SCHOOL_HUB_NAME=
SCHOOL_HUB_SYNC_ENABLED=true
CLOUD_API_BASE_URL=

OFFLINE_SQLITE_SUPPORTED=true
OFFLINE_SQLITE_SCHEMA_VERSION=1
OFFLINE_SYNC_MAX_BATCH=100
OFFLINE_SYNC_PULL_INTERVAL_SECONDS=300
OFFLINE_SYNC_SLOW_NETWORK_QUEUE_WRITES=true

MAX_IMAGE_MB=8
MAX_KVPACK_MB=25

COMMONS_ENABLED=true
COMMONS_REVIEW_REQUIRED=true

LOG_PROMPTS=false
LOG_RAW_IMAGES=false

# Set this to your real deployed frontend origins.
CORS_ORIGINS=https://app.example.com

AUTH_SERVICE_URL=http://auth-service:8001
SCHOOL_SERVICE_URL=http://school-service:8002
LESSON_SERVICE_URL=http://lesson-service:8003
AI_SERVICE_URL=http://ai-service:8004
ASSIGNMENT_SERVICE_URL=http://assignment-service:8005
COMMONS_SERVICE_URL=http://commons-service:8006
REVIEW_SERVICE_URL=http://review-service:8007
SYNC_SERVICE_URL=http://sync-service:8008
EXPORT_SERVICE_URL=http://export-service:8009
NOTIFICATION_SERVICE_URL=http://notification-service:8010
STORAGE_SERVICE_URL=http://storage-service:8011
