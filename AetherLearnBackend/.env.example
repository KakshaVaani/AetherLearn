APP_NAME=AetherLearn
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=info

SERVICE_HOST=0.0.0.0

MONGODB_URI=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

INTERNAL_SERVICE_SECRET=change-me
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

AUTH_DEMO_MODE=true
SEED_DEMO_DATA=true

OBJECT_STORAGE_DRIVER=minio
LOCAL_STORAGE_DIR=.data/storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aetherlearn
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

AI_RUNTIME=ollama
USE_MOCK=false
ALLOW_RUNTIME_FALLBACK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Comma-separated Google OAuth client IDs accepted by backend ID-token verification.
GOOGLE_OAUTH_CLIENT_IDS=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
ENFORCE_GEMMA_MODEL=true
REQUIRED_GEMMA_MODEL=gemma4:e4b

SCHOOL_HUB_MODE=false
SCHOOL_HUB_NAME=
SCHOOL_HUB_SYNC_ENABLED=true
CLOUD_API_BASE_URL=

OFFLINE_SQLITE_SUPPORTED=true
OFFLINE_SQLITE_SCHEMA_VERSION=1
OFFLINE_SYNC_MAX_BATCH=100
OFFLINE_SYNC_PULL_INTERVAL_SECONDS=300
OFFLINE_SYNC_SLOW_NETWORK_QUEUE_WRITES=true

MAX_IMAGE_MB=8
MAX_KVPACK_MB=25

COMMONS_ENABLED=true
COMMONS_REVIEW_REQUIRED=true

LOG_PROMPTS=false
LOG_RAW_IMAGES=false

CORS_ORIGINS=http://localhost:8081,http://localhost:3000,http://192.168.1.35:8081,http://192.168.1.35:3000
