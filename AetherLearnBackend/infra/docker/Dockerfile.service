FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app
COPY pyproject.toml uv.lock* ./
COPY packages ./packages
COPY apps ./apps
COPY scripts ./scripts
RUN uv sync --frozen --no-dev || uv sync --no-dev

ENV PYTHONPATH=/app:/app/packages/shared_schemas:/app/packages/shared_events:/app/packages/shared_utils:/app/packages/service_auth:/app/packages/api_client

CMD ["/app/.venv/bin/uvicorn", "apps.auth_service.app.main:app", "--host", "0.0.0.0", "--port", "8001"]
